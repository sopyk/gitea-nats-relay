# 密钥与连接参数 —— 复制成 relay.env 后填写（relay.env 已被 .gitignore 排除）
#
# cp relay.env.example relay.env
#
# 说明：配置优先级为 **环境变量 > 配置文件 > 代码默认值**。
# 因此这里既放密钥，也放连接地址 —— 文件没配的项会落到这里的值上。
# 配置文件路径默认 /config/webhook2nats.toml，用 CONFIG_FILE 改。
#
# 无需为 relay.env 单独设置 600 权限 —— Docker 在**宿主机侧**读取它并注入为
# 环境变量，这个文件不会进入容器的文件系统。共享文件夹 ACL 已经管好了
# 「其他 DSM 用户能不能读」。

# 配置文件路径。可选，默认 /config/webhook2nats.toml。
# 留空则完全用下面的环境变量配置（不读任何 TOML 文件）。
CONFIG_FILE=/config/webhook2nats.toml

# ── 必填：缺少任一项 relay 启动时会直接退出并打印缺失清单 ──────

# NATS 连接地址。多个用逗号分隔，如 nats://a:4222,nats://b:4222
NATS_SERVERS=nats://<nats-host>:4222

# relay 专用 NATS 账号，服务端 ACL 已限权到三个门铃 subject。
# 注意区分大小写，值不要带引号。
NATS_USER=<nats-user>
NATS_PASSWORD=<nats-password>

# HMAC-SHA256 密钥，必须与 Gitea webhook 配置里的那个完全一致。
WEBHOOK_SECRET=<与 Gitea webhook 配置里同一个密钥>

# ── 可选 ────────────────────────────────────────────────────

# 心跳标识后缀，发布的 subject 是 hb.<RELAY_ID>。留空则不发心跳。
# RELAY_ID=<host>.webhook2nats

# 心跳间隔（秒），默认 60
# NATS_HEARTBEAT_SECONDS=60

# 允许走全厅公告的作者登录名，逗号分隔。留空 = 不发任何公告。
# 代码里没有内置任何默认作者。
# BROADCAST_AUTHORS=<login>,<login>

# 等待 NATS 发布确认的超时（秒），默认 3
# PUBLISH_TIMEOUT_SECONDS=3

# 日志级别：debug / info / warning / error，默认 info。
# info = 投递成功与失败每请求一行；debug 额外记重复、忽略、请求体大小等。
# LOG_LEVEL=info

# 日志格式：text（key=value，给人看）/ json（一行一个 JSON，给 log shipper）。
# 默认 text —— 群晖的 docker logs 里 key=value 最顺眼。
# LOG_FORMAT=text

# 额外的滚动日志文件。留空 = 只写 stdout（docker logs）。
# 填了路径则父目录会自动创建；创建失败会降级成只写 stdout 并打一条警告，
# **不会**让服务起不来。超过 LOG_MAX_BYTES 就轮转，旧文件最多留 LOG_BACKUPS 份。
# LOG_FILE=/data/logs/relay.log

# 单个日志文件的轮转上限（字节），默认 5242880（5MB）
# LOG_MAX_BYTES=5242880

# 轮转保留的旧文件份数，默认 5
# LOG_BACKUPS=5

# ── 以下是协议契约项，有默认值，多实例/多站点部署时才需要显式改 ──

# 定向通知 subject 前缀，最终 subject 为 <prefix>.<host>.<id>
# NOTIFY_SUBJECT_PREFIX=evt.gitea.notify

# 全厅公告 subject
# BROADCAST_SUBJECT=evt.gitea.broadcast

# NATS 连接显示名，便于在 nats-server 连接列表里认出自己
# RELAY_CLIENT_NAME=webhook2nats
